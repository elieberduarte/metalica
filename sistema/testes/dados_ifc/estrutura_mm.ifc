ISO-10303-21;
/* Arquivo de teste escrito à mão. Unidade: MILÍMETRO.
   Pórtico simples para exercitar o reconhecimento estrutural:
     P1  IfcColumn  W 310x38,7   (0,0,0)    -> (0,0,6000)
     V1  IfcBeam    W 310x38,7   (0,0,6000) -> (6000,0,6000)
     T1  IfcMember  TR 33,7x2,65 (0,3000,6000) -> (6000,3000,6000)   .PURLIN.
     C1  IfcMember  L 40x4       (2000,0,0) -> (2000,0,3000)  via IfcMappedItem
     C2  IfcMember  L 40x4       (4000,0,0) -> (4000,0,3000)  via IfcMappedItem
     CH1 IfcPlate   chapa 200 x 300 x 12,7 -> sólido (não é barra)
     VS1 IfcBeam    perfil soldado 1000x400x20x30 -> fora do catálogo, vira sólido  */
HEADER;
FILE_DESCRIPTION(('ViewDefinition [DesignTransferView]'),'2;1');
FILE_NAME('estrutura_mm.ifc','2026-01-01T00:00:00',('teste'),('sistema'),
  'sistema','sistema 1.0','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#2=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#3=IFCUNITASSIGNMENT((#1,#2));
#5=IFCCARTESIANPOINT((0.,0.,0.));
#6=IFCDIRECTION((0.,0.,1.));
#7=IFCDIRECTION((1.,0.,0.));
#8=IFCAXIS2PLACEMENT3D(#5,#6,#7);
#9=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#8,$);
#10=IFCPROJECT('3Ehr0Mmq95GgL6yKXVBB01',$,'Portico de teste',$,$,$,$,(#9),#3);
#11=IFCLOCALPLACEMENT($,#8);
#12=IFCSITE('3Ehr0Mmq95GgL6yKXVBB02',$,'Terreno',$,$,#11,$,$,.ELEMENT.,$,$,$,$,$);
#13=IFCLOCALPLACEMENT(#11,#8);
#14=IFCBUILDING('3Ehr0Mmq95GgL6yKXVBB03',$,'Galpao',$,$,#13,$,$,.ELEMENT.,$,$,$);
#15=IFCLOCALPLACEMENT(#13,#8);
#16=IFCBUILDINGSTOREY('3Ehr0Mmq95GgL6yKXVBB04',$,'Estrutura',$,$,#15,$,$,.ELEMENT.,0.);

/* ---- perfis ---- */
#20=IFCCARTESIANPOINT((0.,0.));
#21=IFCAXIS2PLACEMENT2D(#20,$);
#22=IFCISHAPEPROFILEDEF(.AREA.,'W 310x38,7',#21,165.,310.,5.8,9.7,11.,$,$);
#23=IFCCIRCLEHOLLOWPROFILEDEF(.AREA.,'TR 33,7x2,65',#21,16.85,2.65);
#24=IFCLSHAPEPROFILEDEF(.AREA.,'L 40x4',#21,40.,40.,4.,$,$,$);
#25=IFCRECTANGLEPROFILEDEF(.AREA.,'CH 200x300',#21,200.,300.);
#26=IFCISHAPEPROFILEDEF(.AREA.,'VS 1000x400',#21,400.,1000.,20.,30.,$,$,$);

/* ---- P1: pilar ---- */
#30=IFCLOCALPLACEMENT(#15,#8);
#31=IFCEXTRUDEDAREASOLID(#22,#8,#6,6000.);
#32=IFCSHAPEREPRESENTATION(#9,'Body','SweptSolid',(#31));
#33=IFCPRODUCTDEFINITIONSHAPE($,$,(#32));
#34=IFCCOLUMN('3Ehr0Mmq95GgL6yKXVBB05',$,'P1',$,$,#30,#33,'P1',.COLUMN.);

/* ---- V1: viga, eixo local Z apontando para +X global ---- */
#40=IFCCARTESIANPOINT((0.,0.,6000.));
#41=IFCDIRECTION((1.,0.,0.));
#42=IFCDIRECTION((0.,0.,1.));
#43=IFCAXIS2PLACEMENT3D(#40,#41,#42);
#44=IFCLOCALPLACEMENT(#15,#43);
#45=IFCEXTRUDEDAREASOLID(#22,#8,#6,6000.);
#46=IFCSHAPEREPRESENTATION(#9,'Body','SweptSolid',(#45));
#47=IFCPRODUCTDEFINITIONSHAPE($,$,(#46));
#48=IFCBEAM('3Ehr0Mmq95GgL6yKXVBB06',$,'V1',$,$,#44,#47,'V1',.BEAM.);

/* ---- T1: terça tubular ---- */
#50=IFCCARTESIANPOINT((0.,3000.,6000.));
#51=IFCAXIS2PLACEMENT3D(#50,#41,#42);
#52=IFCLOCALPLACEMENT(#15,#51);
#53=IFCEXTRUDEDAREASOLID(#23,#8,#6,6000.);
#54=IFCSHAPEREPRESENTATION(#9,'Body','SweptSolid',(#53));
#55=IFCPRODUCTDEFINITIONSHAPE($,$,(#54));
#56=IFCMEMBER('3Ehr0Mmq95GgL6yKXVBB07',$,'T1',$,$,#52,#55,'T1',.PURLIN.);

/* ---- C1 e C2: mesma geometria reaproveitada por IfcMappedItem ---- */
#60=IFCEXTRUDEDAREASOLID(#24,#8,#6,3000.);
#61=IFCSHAPEREPRESENTATION(#9,'Body','SweptSolid',(#60));
#62=IFCREPRESENTATIONMAP(#8,#61);
#63=IFCCARTESIANPOINT((2000.,0.,0.));
#64=IFCCARTESIANTRANSFORMATIONOPERATOR3D($,$,#63,$,$);
#65=IFCMAPPEDITEM(#62,#64);
#66=IFCSHAPEREPRESENTATION(#9,'Body','MappedRepresentation',(#65));
#67=IFCPRODUCTDEFINITIONSHAPE($,$,(#66));
#68=IFCLOCALPLACEMENT(#15,#8);
#69=IFCMEMBER('3Ehr0Mmq95GgL6yKXVBB08',$,'C1',$,$,#68,#67,'C1',.BRACE.);
#70=IFCCARTESIANPOINT((4000.,0.,0.));
#71=IFCCARTESIANTRANSFORMATIONOPERATOR3D($,$,#70,$,$);
#72=IFCMAPPEDITEM(#62,#71);
#73=IFCSHAPEREPRESENTATION(#9,'Body','MappedRepresentation',(#72));
#74=IFCPRODUCTDEFINITIONSHAPE($,$,(#73));
#75=IFCLOCALPLACEMENT(#15,#8);
#76=IFCMEMBER('3Ehr0Mmq95GgL6yKXVBB09',$,'C2',$,$,#75,#74,'C2',.BRACE.);

/* ---- CH1: chapa retangular 200 x 300 x 12,7 ---- */
#80=IFCCARTESIANPOINT((0.,0.,6000.));
#81=IFCAXIS2PLACEMENT3D(#80,$,$);
#82=IFCLOCALPLACEMENT(#15,#81);
#83=IFCEXTRUDEDAREASOLID(#25,#8,#6,12.7);
#84=IFCSHAPEREPRESENTATION(#9,'Body','SweptSolid',(#83));
#85=IFCPRODUCTDEFINITIONSHAPE($,$,(#84));
#86=IFCPLATE('3Ehr0Mmq95GgL6yKXVBB10',$,'CH1',$,$,#82,#85,'CH1',.SHEET.);

/* ---- VS1: perfil soldado fora do catálogo ---- */
#90=IFCCARTESIANPOINT((0.,6000.,6000.));
#91=IFCAXIS2PLACEMENT3D(#90,#41,#42);
#92=IFCLOCALPLACEMENT(#15,#91);
#93=IFCEXTRUDEDAREASOLID(#26,#8,#6,6000.);
#94=IFCSHAPEREPRESENTATION(#9,'Body','SweptSolid',(#93));
#95=IFCPRODUCTDEFINITIONSHAPE($,$,(#94));
#96=IFCBEAM('3Ehr0Mmq95GgL6yKXVBB11',$,'VS1',$,$,#92,#95,'VS1',.BEAM.);

/* ---- hierarquia, material e propriedades ---- */
#100=IFCRELAGGREGATES('3Ehr0Mmq95GgL6yKXVBB12',$,$,$,#10,(#12));
#101=IFCRELAGGREGATES('3Ehr0Mmq95GgL6yKXVBB13',$,$,$,#12,(#14));
#102=IFCRELAGGREGATES('3Ehr0Mmq95GgL6yKXVBB14',$,$,$,#14,(#16));
#103=IFCRELCONTAINEDINSPATIALSTRUCTURE('3Ehr0Mmq95GgL6yKXVBB15',$,$,$,
  (#34,#48,#56,#69,#76,#86,#96),#16);
#110=IFCMATERIAL('Aco ASTM A572 Gr.50',$,'Steel');
#111=IFCRELASSOCIATESMATERIAL('3Ehr0Mmq95GgL6yKXVBB16',$,$,$,
  (#34,#48,#56,#69,#76,#86,#96),#110);
#120=IFCPROPERTYSINGLEVALUE('Reference',$,IFCIDENTIFIER('W 310x38,7'),$);
#121=IFCPROPERTYSINGLEVALUE('Span',$,IFCPOSITIVELENGTHMEASURE(6000.),$);
#122=IFCPROPERTYSINGLEVALUE('IsExternal',$,IFCBOOLEAN(.F.),$);
#123=IFCPROPERTYSET('3Ehr0Mmq95GgL6yKXVBB17',$,'Pset_BeamCommon',$,(#120,#121,#122));
#124=IFCRELDEFINESBYPROPERTIES('3Ehr0Mmq95GgL6yKXVBB18',$,$,$,(#48),#123);
ENDSEC;
END-ISO-10303-21;
