ISO-10303-21;
/* Arquivo de teste escrito à mão. Unidade: MILÍMETRO. Um elemento por tipo de
   geometria, todos na origem, com o volume esperado ao lado:
     G1  extrusão 100x100x1000 recortada por meio-espaço em z=600   ->  4,0e6 mm3
     G2  IfcSweptDiskSolid r=50 ao longo de 1000                     ~  7,85e6 mm3
     G3  IfcTriangulatedFaceSet, cubo de 1000                        ->  1,0e9 mm3
     G4  IfcPolygonalFaceSet, cubo de 500                            ->  1,25e8 mm3
     G5  quadrado 400 com furo quadrado 200, extrudado 100           ->  1,2e7 mm3
     G6  meio disco r=100 (IfcCompositeCurve com arco), extrudado 10 ~  1,571e5 mm3
     G7  IfcAdvancedBrep (não suportado) -> caixa envolvente 200x300x400 + aviso  */
HEADER;
FILE_DESCRIPTION(('ViewDefinition [ReferenceView]'),'2;1');
FILE_NAME('geometrias_mm.ifc','2026-01-01T00:00:00',('teste'),('sistema'),
  'sistema','sistema 1.0','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#2=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#3=IFCUNITASSIGNMENT((#1,#2));
#5=IFCCARTESIANPOINT((0.,0.,0.));
#6=IFCDIRECTION((0.,0.,1.));
#7=IFCDIRECTION((1.,0.,0.));
#8=IFCAXIS2PLACEMENT3D(#5,#6,#7);
#9=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#8,$);
#10=IFCPROJECT('3Ehr0Mmq95GgL6yKXVCB01',$,'Geometrias',$,$,$,$,(#9),#3);
#11=IFCLOCALPLACEMENT($,#8);
#12=IFCBUILDINGSTOREY('3Ehr0Mmq95GgL6yKXVCB02',$,'Nivel 0',$,$,#11,$,$,.ELEMENT.,0.);
#13=IFCRELAGGREGATES('3Ehr0Mmq95GgL6yKXVCB03',$,$,$,#10,(#12));
#14=IFCCARTESIANPOINT((0.,0.));
#15=IFCAXIS2PLACEMENT2D(#14,$);

/* G1: extrusão recortada por meio-espaço */
#20=IFCRECTANGLEPROFILEDEF(.AREA.,$,#15,100.,100.);
#21=IFCEXTRUDEDAREASOLID(#20,#8,#6,1000.);
#22=IFCCARTESIANPOINT((0.,0.,600.));
#23=IFCAXIS2PLACEMENT3D(#22,#6,#7);
#24=IFCPLANE(#23);
#25=IFCHALFSPACESOLID(#24,.T.);
#26=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#21,#25);
#27=IFCSHAPEREPRESENTATION(#9,'Body','Clipping',(#26));
#28=IFCPRODUCTDEFINITIONSHAPE($,$,(#27));
#29=IFCBUILDINGELEMENTPROXY('3Ehr0Mmq95GgL6yKXVCB04',$,'G1',$,$,#11,#28,$,$);

/* G2: tubo varrido */
#30=IFCCARTESIANPOINT((0.,0.,0.));
#31=IFCCARTESIANPOINT((0.,0.,1000.));
#32=IFCPOLYLINE((#30,#31));
#33=IFCSWEPTDISKSOLID(#32,50.,$,$,$);
#34=IFCSHAPEREPRESENTATION(#9,'Body','AdvancedSweptSolid',(#33));
#35=IFCPRODUCTDEFINITIONSHAPE($,$,(#34));
#36=IFCFLOWSEGMENT('3Ehr0Mmq95GgL6yKXVCB05',$,'G2',$,$,#11,#35,$);

/* G3: malha triangulada (cubo de 1000) */
#40=IFCCARTESIANPOINTLIST3D(((0.,0.,0.),(1000.,0.,0.),(1000.,1000.,0.),(0.,1000.,0.),
  (0.,0.,1000.),(1000.,0.,1000.),(1000.,1000.,1000.),(0.,1000.,1000.)),$);
#41=IFCTRIANGULATEDFACESET(#40,$,.T.,((1,3,2),(1,4,3),(5,6,7),(5,7,8),(1,2,6),(1,6,5),
  (2,3,7),(2,7,6),(3,4,8),(3,8,7),(4,1,5),(4,5,8)),$);
#42=IFCSHAPEREPRESENTATION(#9,'Body','Tessellation',(#41));
#43=IFCPRODUCTDEFINITIONSHAPE($,$,(#42));
#44=IFCBUILDINGELEMENTPROXY('3Ehr0Mmq95GgL6yKXVCB06',$,'G3',$,$,#11,#43,$,$);

/* G4: malha poligonal (cubo de 500) */
#50=IFCCARTESIANPOINTLIST3D(((0.,0.,0.),(500.,0.,0.),(500.,500.,0.),(0.,500.,0.),
  (0.,0.,500.),(500.,0.,500.),(500.,500.,500.),(0.,500.,500.)),$);
#51=IFCINDEXEDPOLYGONALFACE((1,4,3,2));
#52=IFCINDEXEDPOLYGONALFACE((5,6,7,8));
#53=IFCINDEXEDPOLYGONALFACE((1,2,6,5));
#54=IFCINDEXEDPOLYGONALFACE((2,3,7,6));
#55=IFCINDEXEDPOLYGONALFACE((3,4,8,7));
#56=IFCINDEXEDPOLYGONALFACE((4,1,5,8));
#57=IFCPOLYGONALFACESET(#50,.T.,(#51,#52,#53,#54,#55,#56),$);
#58=IFCSHAPEREPRESENTATION(#9,'Body','Tessellation',(#57));
#59=IFCPRODUCTDEFINITIONSHAPE($,$,(#58));
#60=IFCBUILDINGELEMENTPROXY('3Ehr0Mmq95GgL6yKXVCB07',$,'G4',$,$,#11,#59,$,$);

/* G5: contorno com vazio */
#70=IFCCARTESIANPOINT((-200.,-200.));
#71=IFCCARTESIANPOINT((200.,-200.));
#72=IFCCARTESIANPOINT((200.,200.));
#73=IFCCARTESIANPOINT((-200.,200.));
#74=IFCPOLYLINE((#70,#71,#72,#73,#70));
#75=IFCCARTESIANPOINT((-100.,-100.));
#76=IFCCARTESIANPOINT((100.,-100.));
#77=IFCCARTESIANPOINT((100.,100.));
#78=IFCCARTESIANPOINT((-100.,100.));
#79=IFCPOLYLINE((#75,#78,#77,#76,#75));
#80=IFCARBITRARYPROFILEDEFWITHVOIDS(.AREA.,'quadro',#74,(#79));
#81=IFCEXTRUDEDAREASOLID(#80,#8,#6,100.);
#82=IFCSHAPEREPRESENTATION(#9,'Body','SweptSolid',(#81));
#83=IFCPRODUCTDEFINITIONSHAPE($,$,(#82));
#84=IFCSLAB('3Ehr0Mmq95GgL6yKXVCB08',$,'G5',$,$,#11,#83,$,.FLOOR.);

/* G6: meio disco por curva composta (reta + arco aparado em radianos) */
#90=IFCCARTESIANPOINT((-100.,0.));
#91=IFCCARTESIANPOINT((100.,0.));
#92=IFCPOLYLINE((#90,#91));
#93=IFCCIRCLE(#15,100.);
#94=IFCTRIMMEDCURVE(#93,(IFCPARAMETERVALUE(0.)),(IFCPARAMETERVALUE(3.14159265358979)),
  .T.,.PARAMETER.);
#95=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#92);
#96=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#94);
#97=IFCCOMPOSITECURVE((#95,#96),.F.);
#98=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'meio disco',#97);
#99=IFCEXTRUDEDAREASOLID(#98,#8,#6,10.);
#100=IFCSHAPEREPRESENTATION(#9,'Body','SweptSolid',(#99));
#101=IFCPRODUCTDEFINITIONSHAPE($,$,(#100));
#102=IFCBUILDINGELEMENTPROXY('3Ehr0Mmq95GgL6yKXVCB09',$,'G6',$,$,#11,#101,$,$);

/* G7: brep avançado (não suportado) */
#110=IFCCARTESIANPOINT((0.,0.,0.));
#111=IFCCARTESIANPOINT((200.,0.,0.));
#112=IFCCARTESIANPOINT((200.,300.,0.));
#113=IFCCARTESIANPOINT((0.,300.,400.));
#114=IFCPOLYLOOP((#110,#111,#112,#113));
#115=IFCFACEOUTERBOUND(#114,.T.);
#116=IFCPLANE(#8);
#117=IFCADVANCEDFACE((#115),#116,.T.);
#118=IFCCLOSEDSHELL((#117));
#119=IFCADVANCEDBREP(#118);
#120=IFCSHAPEREPRESENTATION(#9,'Body','AdvancedBrep',(#119));
#121=IFCPRODUCTDEFINITIONSHAPE($,$,(#120));
#122=IFCBUILDINGELEMENTPROXY('3Ehr0Mmq95GgL6yKXVCB10',$,'G7',$,$,#11,#121,$,$);

#130=IFCRELCONTAINEDINSPATIALSTRUCTURE('3Ehr0Mmq95GgL6yKXVCB11',$,$,$,
  (#29,#36,#44,#60,#84,#102,#122),#12);
ENDSEC;
END-ISO-10303-21;
