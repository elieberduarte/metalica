ISO-10303-21;
/* Arquivo de teste escrito à mão.
   Unidade: METRO (o caso mais comum em IFC de arquitetura).
   Hierarquia: Projeto > Terreno > Prédio (10,20,0) > Pavimento (+3) > caixa (1,1,0).
   A caixa é um IfcFacetedBrep de 1 x 2 x 3 m, logo:
       canto global = (11 m, 21 m, 3 m) = (11000, 21000, 3000) mm
       volume       = 6 m3 = 6e9 mm3                                              */
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('caixa_metro.ifc','2026-01-01T00:00:00',('teste'),('sistema'),
  'sistema','sistema 1.0','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#3=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#4=IFCUNITASSIGNMENT((#1,#2,#3));
#5=IFCCARTESIANPOINT((0.,0.,0.));
#6=IFCDIRECTION((0.,0.,1.));
#7=IFCDIRECTION((1.,0.,0.));
#8=IFCAXIS2PLACEMENT3D(#5,#6,#7);
#9=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#8,$);
#10=IFCPROJECT('3Ehr0Mmq95GgL6yKXVAB01',$,'Projeto de teste',$,$,$,$,(#9),#4);
#11=IFCLOCALPLACEMENT($,#8);
#12=IFCSITE('3Ehr0Mmq95GgL6yKXVAB02',$,'Terreno',$,$,#11,$,$,.ELEMENT.,$,$,$,$,$);
#13=IFCCARTESIANPOINT((10.,20.,0.));
#14=IFCAXIS2PLACEMENT3D(#13,$,$);
#15=IFCLOCALPLACEMENT(#11,#14);
#16=IFCBUILDING('3Ehr0Mmq95GgL6yKXVAB03',$,'Predio',$,$,#15,$,$,.ELEMENT.,$,$,$);
#17=IFCCARTESIANPOINT((0.,0.,3.));
#18=IFCAXIS2PLACEMENT3D(#17,$,$);
#19=IFCLOCALPLACEMENT(#15,#18);
#20=IFCBUILDINGSTOREY('3Ehr0Mmq95GgL6yKXVAB04',$,'Pavimento Terreo',$,$,#19,$,$,
  .ELEMENT.,3.);
#21=IFCCARTESIANPOINT((1.,1.,0.));
#22=IFCAXIS2PLACEMENT3D(#21,$,$);
#23=IFCLOCALPLACEMENT(#19,#22);

/* casca fechada da caixa */
#30=IFCCARTESIANPOINT((0.,0.,0.));
#31=IFCCARTESIANPOINT((1.,0.,0.));
#32=IFCCARTESIANPOINT((1.,2.,0.));
#33=IFCCARTESIANPOINT((0.,2.,0.));
#34=IFCCARTESIANPOINT((0.,0.,3.));
#35=IFCCARTESIANPOINT((1.,0.,3.));
#36=IFCCARTESIANPOINT((1.,2.,3.));
#37=IFCCARTESIANPOINT((0.,2.,3.));
#40=IFCPOLYLOOP((#30,#33,#32,#31));
#41=IFCPOLYLOOP((#34,#35,#36,#37));
#42=IFCPOLYLOOP((#30,#31,#35,#34));
#43=IFCPOLYLOOP((#31,#32,#36,#35));
#44=IFCPOLYLOOP((#32,#33,#37,#36));
#45=IFCPOLYLOOP((#33,#30,#34,#37));
#50=IFCFACEOUTERBOUND(#40,.T.);
#51=IFCFACEOUTERBOUND(#41,.T.);
#52=IFCFACEOUTERBOUND(#42,.T.);
#53=IFCFACEOUTERBOUND(#43,.T.);
#54=IFCFACEOUTERBOUND(#44,.T.);
#55=IFCFACEOUTERBOUND(#45,.T.);
#60=IFCFACE((#50));
#61=IFCFACE((#51));
#62=IFCFACE((#52));
#63=IFCFACE((#53));
#64=IFCFACE((#54));
#65=IFCFACE((#55));
#70=IFCCLOSEDSHELL((#60,#61,#62,#63,#64,#65));
#71=IFCFACETEDBREP(#70);
#72=IFCSHAPEREPRESENTATION(#9,'Body','Brep',(#71));
#73=IFCPRODUCTDEFINITIONSHAPE($,$,(#72));
#74=IFCBUILDINGELEMENTPROXY('3Ehr0Mmq95GgL6yKXVAB05',$,'Caixa de teste',$,$,#23,#73,
  'CX-1',.ELEMENT.);

/* hierarquia */
#80=IFCRELAGGREGATES('3Ehr0Mmq95GgL6yKXVAB06',$,$,$,#10,(#12));
#81=IFCRELAGGREGATES('3Ehr0Mmq95GgL6yKXVAB07',$,$,$,#12,(#16));
#82=IFCRELAGGREGATES('3Ehr0Mmq95GgL6yKXVAB08',$,$,$,#16,(#20));
#83=IFCRELCONTAINEDINSPATIALSTRUCTURE('3Ehr0Mmq95GgL6yKXVAB09',$,$,$,(#74),#20);

/* material com cor e um conjunto de propriedades */
#90=IFCMATERIAL('Concreto C30',$,'Concreto');
#91=IFCCOLOURRGB($,0.72,0.70,0.65);
#92=IFCSURFACESTYLERENDERING(#91,0.,$,$,$,$,$,$,.FLAT.);
#93=IFCSURFACESTYLE('Concreto',.BOTH.,(#92));
#94=IFCPRESENTATIONSTYLEASSIGNMENT((#93));
#95=IFCSTYLEDITEM($,(#94),$);
#96=IFCSTYLEDREPRESENTATION(#9,'Style','Material',(#95));
#97=IFCMATERIALDEFINITIONREPRESENTATION($,$,(#96),#90);
#98=IFCRELASSOCIATESMATERIAL('3Ehr0Mmq95GgL6yKXVAB10',$,$,$,(#74),#90);
#100=IFCPROPERTYSINGLEVALUE('Reference',$,IFCIDENTIFIER('CX-1'),$);
#101=IFCPROPERTYSINGLEVALUE('IsExternal',$,IFCBOOLEAN(.F.),$);
#102=IFCPROPERTYSINGLEVALUE('LoadBearing',$,IFCBOOLEAN(.T.),$);
#103=IFCPROPERTYSET('3Ehr0Mmq95GgL6yKXVAB11',$,'Pset_BuildingElementProxyCommon',$,
  (#100,#101,#102));
#104=IFCRELDEFINESBYPROPERTIES('3Ehr0Mmq95GgL6yKXVAB12',$,$,$,(#74),#103);
#110=IFCQUANTITYVOLUME('GrossVolume',$,$,6.,$);
#111=IFCQUANTITYLENGTH('Height',$,$,3.,$);
#112=IFCELEMENTQUANTITY('3Ehr0Mmq95GgL6yKXVAB13',$,'BaseQuantities',$,$,(#110,#111));
#113=IFCRELDEFINESBYPROPERTIES('3Ehr0Mmq95GgL6yKXVAB14',$,$,$,(#74),#112);
ENDSEC;
END-ISO-10303-21;
